  regions:
  - id: center
    label: Palace courtyard (Round-1 start)
    identity: Open blue-grey paving plane, nothing taller than 0.45 m inside the
      square; four planter corners are the only accents - the reference silhouette
      against which every other region reads
    sightlineClass: long
    polygonXZ:
    - -13.5
    - -13.5
    - 13.5
    - -13.5
    - 13.5
    - 13.5
    - -13.5
    - 13.5
  - id: north
    label: Palace front + broad stone way
    identity: 'Longest horizontal: plaster + grey roof band of the palace over a
      14 m wide stone way; dark timber posts at 3.4 m rhythm frame the way, planters
      keep the green as thin strips, two mauve sakura flank the facade'
    sightlineClass: long
    polygonXZ:
    - -13.5
    - 13.5
    - 13.5
    - 13.5
    - 45
    - 37.5
