  - id: east
    label: Sakura garden
    identity: 'Mauve crowns over stone: 12 sakura pairs, stone lanterns and planter+cap
      low walls (<= 0.55 m) edge the curved medium paths; the fork diamond holds
      the hero tree'
    sightlineClass: medium
    polygonXZ:
    - 13.5
    - -13.5
    - 45
    - -37.5
    - 45
    - 37.5
    - 13.5
