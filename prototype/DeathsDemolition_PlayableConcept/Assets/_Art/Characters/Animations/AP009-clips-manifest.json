  "armature": "PlayerRig",
  "bones": 56,
  "identical_to": "AP-006 rig_template_v001 / AP-007 ZombieRig; Unity Humanoid",
  "root_motion": false,
  "in_place": "Root never moves; Hips carries bob/sink only; locomotion is code-driven (CharacterAnimationSet.SpeedParameterFor)"
 },
 "events": {
  "convention": "frame index at 30 fps from the clip start; also stored as Blender pose markers on the action and as the armature custom property AP009_events ('name=frame;\u2026') in each FBX",
