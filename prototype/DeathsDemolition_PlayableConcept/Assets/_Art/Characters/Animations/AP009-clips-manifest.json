   "foot_l/foot_r": "foot contact (footstep sfx / decal)",
   "hit_window_start/hit_window_end": "attack active window (DEC-029: the hitbox is ON only between these frames)",
   "fire": "muzzle / recoil frame",
   "hit": "reaction start",
   "death_end": "last frame \u2014 hold and despawn",
   "rise_end": "spawn finished",
   "pickup": "grab frame",
   "stagger_end": "stagger recovered"
  }
 },
 "layers": {
  "base": "full-body state (Animator base layer)",
  "override_upper": "upper-body override layer (hit reactions) \u2014 play at weight 1 over locomotion, mask Spine+",
  "additive": "additive layer (recoil, regional flinches): first frame is the reference pose (deltas from rest)",
  "aim_layer": "WP-018: rotate Spine/Chest/UpperChest toward the aim direction on top of the base (REQ-038)"
 },
 "speed_reference": "speed_mps = the measured ground speed at which the in-place cycle shows no foot slide (mean stance-foot ankle displacement x 30 fps; playback rate 1.0). Unity scales the playback rate by MoveSpeed / speed_mps \u2014 see README \u00a7speed table; v002: dedicated player run cycles (run_fwd/back/strafe_l/r, flight phase) \u2014 blend walk->run above ~1.6x the walk speed_mps (walk scaled beyond x2.1 reads as skating)",
