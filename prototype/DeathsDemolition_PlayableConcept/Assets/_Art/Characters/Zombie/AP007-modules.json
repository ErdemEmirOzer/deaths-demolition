 "assembly": {
  "zombie": "ZombieRig + zombie_body_<fit>_LOD* + one top + one bottom + one head (H0 = no head module)",
  "binding": "every module mesh is skinned to the same bone names; in Unity re-point SkinnedMeshRenderer.bones/rootBone of the module to the body prefab's ZombieRig transforms (by name), or import each module FBX with the same Humanoid avatar",
  "lod": "LOD0..3 per mesh; combine into one LODGroup per zombie (body+top+bottom+head at the same LOD index); per-zombie worst case 11900 / 4980 / 1780 / 590 tris",
  "material": "M_Zombie_Atlas (body, straw, hair, sash) + M_Zombie_Cloth (cloth atlas v002) \u2014 <= 2 materials per zombie, no per-instance material (SRP batching); colour variety = module colourway meshes (cw1 dark / cw2 faded) + module mix",
  "combinations": "3 fits x 7 tops (5 with 2 cw) x 7 bottoms (6 with 2 cw) x 6 heads = 3 x 12 x 13 x 6 = 2808 distinct looks; 24 reference looks in looks[]",
  "rules": [
   "T7_mino_cape never together with ArmorSlot.Body Present (conflicts with the do) -> pick another top at spawn",
   "T5/B6 torn variants: mirror (scale x -1 is NOT allowed on skinned meshes) -> the missing sleeve/leg is always the RIGHT side; vary with yaw/pose",
   "H0 bald <= 25 % of a crowd, T7 <= 10 %, B5 fundoshi cw2 (light) <= 10 %",
   "version tint (IEnemyVersionVisual): tint only where Mask.G = 1 (cloth); never skin (Mask.R); emissive only where Mask.A = 1 (sash band) and only if DEC-067 allows it later",
   "helmet Present: H1-H5 head modules stay (hidden under the kabuto by the helmet mesh); H2 hair reaches z 1.40 - kabuto shikoro sits over it"
  ],
  "capsule": "all fits + modules fit the 1.8 m x 0.45 m-radius capsule (torso/leg envelope <= 0.46 m, T7 mino hem); A-pose arms/sleeves excluded"
 },
