# ===== Deaths Demolition · .gitattributes (WP-000 Production Baseline, 2026-09-10) =====
# Proje Unix satır sonu kullanıyor (EditorSettings m_LineEndingsForNewScripts=1; CRLF=0 ölçüldü).
* text=auto eol=lf

# Kaynak / metin
*.cs            text eol=lf diff=csharp
*.md            text eol=lf
*.json          text eol=lf
*.txt           text eol=lf
*.asmdef        text eol=lf
*.asmref        text eol=lf
*.inputactions  text eol=lf
*.shader        text eol=lf
*.hlsl          text eol=lf
*.cginc         text eol=lf
*.uxml          text eol=lf
*.uss           text eol=lf

# Unity YAML (Force Text) — UnityYAMLMerge ile birleştirilir
# (merge.unityyamlmerge sürücüsü yerel git config'te tanımlanmalıdır; tanımsızsa git normal metin birleştirmesine düşer)
*.unity         text eol=lf merge=unityyamlmerge diff
*.prefab        text eol=lf merge=unityyamlmerge diff
*.asset         text eol=lf merge=unityyamlmerge diff
*.mat           text eol=lf merge=unityyamlmerge diff
# .meta dosyaları %YAML başlığı taşımaz; UnityYAMLMerge bunları reddeder (exit 1) → normal metin merge (WP-001 ölçümü)
*.meta          text eol=lf diff
*.controller    text eol=lf merge=unityyamlmerge diff
*.anim          text eol=lf merge=unityyamlmerge diff
*.overrideController text eol=lf merge=unityyamlmerge diff
*.physicMaterial text eol=lf merge=unityyamlmerge diff
*.physicsMaterial2D text eol=lf merge=unityyamlmerge diff
*.playable      text eol=lf merge=unityyamlmerge diff
*.mask          text eol=lf merge=unityyamlmerge diff
*.guiskin       text eol=lf merge=unityyamlmerge diff
*.flare         text eol=lf merge=unityyamlmerge diff
*.fontsettings  text eol=lf merge=unityyamlmerge diff
*.spriteatlas   text eol=lf merge=unityyamlmerge diff
*.terrainlayer  text eol=lf merge=unityyamlmerge diff
*.mixer         text eol=lf merge=unityyamlmerge diff
*.shadervariants text eol=lf merge=unityyamlmerge diff
*.preset        text eol=lf merge=unityyamlmerge diff

# İkili varlıklar — Git LFS (WP-011 M3 Content Pipeline Pilot, 2026-09-15; kullanıcı kararı §2)
# Kural: ikili asset türleri LFS ile izlenir (filter=lfs diff=lfs merge=lfs -text). LFS yalnız bu pakette kuruldu
# (git lfs install --local); remote yok, push yok. İzlenen dosyalar manifestte içerik hash'iyle listelenir (ADR-011-2).
# Mesh / kaynak sahne
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
# Doku
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.tiff  filter=lfs diff=lfs merge=lfs -text
*.gif   filter=lfs diff=lfs merge=lfs -text
*.cubemap filter=lfs diff=lfs merge=lfs -text
# Ses
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
*.aif   filter=lfs diff=lfs merge=lfs -text
*.aiff  filter=lfs diff=lfs merge=lfs -text
*.flac  filter=lfs diff=lfs merge=lfs -text
# Yazı tipi
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
# Derlenmiş ikili (LFS dışı; yalnız binary — bugün depoda yok)
*.dll  binary
*.so   binary
*.dylib binary
*.a    binary
*.bundle binary
